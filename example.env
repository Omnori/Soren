# ==============================================================================
# Soren Bot - Environment Configuration Template
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# Discord Bot Credentials
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# Security: 64-character hex key (32 bytes) for AES-256-GCM encryption at rest
CONFIG_ENCRYPTION_KEY=""

# AI Provider Selection: 'nvidia' | 'groq' | 'gemini' (default: nvidia)
SUMMARY_PROVIDER="nvidia"

# ------------------------------------------------------------------------------
# NVIDIA NIM (Default Provider for Summarization & Assistant)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# ------------------------------------------------------------------------------
# Groq (Used for Voice STT Transcription and Groq Fallback)
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="whisper-large-v3-turbo"
GROQ_SUMMARY_MODEL="openai/gpt-oss-120b"
GROQ_WHISPER_PROMPT="This is a Hinglish speech conversation written in Roman script (Latin alphabet), e.g. Haan bhai main code push kar raha hoon."

# ------------------------------------------------------------------------------
# Google Gemini (Google AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_USE_VERTEX="false"